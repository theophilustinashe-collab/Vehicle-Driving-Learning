{
  "expo": {
    "name": "Roadify",
    "slug": "roadify",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roadify.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#0c4a35"
      },
      "package": "com.roadify.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c4a35"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Roadify to use your location."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "runtimeVersion": "1.0.1",
    "extra": {
      "EXPO_PUBLIC_API_URL": "https://vehicle-driving-learning-4.onrender.com",
      "eas": {
        "projectId": "fd05237d-e159-4153-a3cb-3a9f84d78fb8"
      }
    },
    "owner": "yrtdddd4"
  }
}
