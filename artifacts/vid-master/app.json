{
  "expo": {
    "name": "Roadify",
    "slug": "roadify",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "userInterfaceStyle": "light",
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/39675c10-618b-486d-b8e6-bb801d095cfe"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roadify.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#0c4a35"
      },
      "package": "com.roadify.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c4a35"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysPermission": "Allow Roadify to use your location."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "runtimeVersion": "1.0.1",
    "extra": {
      "eas": {
        "projectId": "39675c10-618b-486d-b8e6-bb801d095cfe"
      }
    }
  }
}
